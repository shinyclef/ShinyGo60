/* Custom Defined Behaviors */
/ {
behaviors {
    /*
     * ? / key
     *
     * No Shift:
     *   tap                  = ?
     *   hold alone           = /
     *   press another key    = ?
     *
     * Shift:
     *   always /
     */

    inv_slash_hold: inverted_slash_hold {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;

        bindings = <&kp SLASH>, <&kp SLASH>;
        mods = <(MOD_LSFT | MOD_RSFT)>;
    };

    inv_slash_tap: inverted_slash_tap {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;

        bindings = <&kp QUESTION>, <&kp SLASH>;
        mods = <(MOD_LSFT | MOD_RSFT)>;
    };

    inv_slash: inverted_slash {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "hold-preferred";
        tapping-term-ms = <200>;

        /*
         * Dummy, unreachable GO60 position.
         *
         * Because every real key is outside this list, pressing any
         * other key while inv_slash is undecided forces the tap action.
         *
         * Holding inv_slash by itself still produces the hold action.
         */
        hold-trigger-key-positions = <999>;

        bindings = <&inv_slash_hold>, <&inv_slash_tap>;
    };


        /*
     * Number keys
     *
     * Example for 1:
     *   tap        = F1
     *   Shift+tap  = Shift+F1
     *   hold       = !
     *   Shift+hold = 1
     *
     * Hold-preferred means pressing another key while the
     * number key is held selects the hold output.
     */


    /*
     * Hold outputs
     *
     * Without Shift: symbol
     * With Shift:    plain number
     *
     * Mod-morph removes Shift from the shifted branch,
     * allowing &kp N1 to output 1 rather than !.
     */

    fn_num_1_hold: fn_number_1_hold {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;

        bindings = <&kp EXCL>, <&kp N1>;
        mods = <(MOD_LSFT | MOD_RSFT)>;
    };

    fn_num_2_hold: fn_number_2_hold {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;

        bindings = <&kp AT>, <&kp N2>;
        mods = <(MOD_LSFT | MOD_RSFT)>;
    };

    fn_num_3_hold: fn_number_3_hold {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;

        bindings = <&kp HASH>, <&kp N3>;
        mods = <(MOD_LSFT | MOD_RSFT)>;
    };

    fn_num_4_hold: fn_number_4_hold {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;

        bindings = <&kp DLLR>, <&kp N4>;
        mods = <(MOD_LSFT | MOD_RSFT)>;
    };

    fn_num_5_hold: fn_number_5_hold {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;

        bindings = <&kp PRCNT>, <&kp N5>;
        mods = <(MOD_LSFT | MOD_RSFT)>;
    };

    fn_num_6_hold: fn_number_6_hold {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;

        bindings = <&kp CARET>, <&kp N6>;
        mods = <(MOD_LSFT | MOD_RSFT)>;
    };

    fn_num_7_hold: fn_number_7_hold {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;

        bindings = <&kp AMPS>, <&kp N7>;
        mods = <(MOD_LSFT | MOD_RSFT)>;
    };

    fn_num_8_hold: fn_number_8_hold {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;

        bindings = <&kp STAR>, <&kp N8>;
        mods = <(MOD_LSFT | MOD_RSFT)>;
    };

    fn_num_9_hold: fn_number_9_hold {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;

        bindings = <&kp LPAR>, <&kp N9>;
        mods = <(MOD_LSFT | MOD_RSFT)>;
    };

    fn_num_0_hold: fn_number_0_hold {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;

        bindings = <&kp RPAR>, <&kp N0>;
        mods = <(MOD_LSFT | MOD_RSFT)>;
    };


    /*
     * Outer hold-taps
     *
     * Parameter 1 is a dummy value for the zero-parameter
     * hold mod-morph.
     *
     * Parameter 2 is the F-key used by the tap branch.
     */

    fn_num_1: fn_number_1 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "hold-preferred";
        tapping-term-ms = <200>;

        bindings = <&fn_num_1_hold>, <&kp>;
    };

    fn_num_2: fn_number_2 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "hold-preferred";
        tapping-term-ms = <200>;

        bindings = <&fn_num_2_hold>, <&kp>;
    };

    fn_num_3: fn_number_3 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "hold-preferred";
        tapping-term-ms = <200>;

        bindings = <&fn_num_3_hold>, <&kp>;
    };

    fn_num_4: fn_number_4 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "hold-preferred";
        tapping-term-ms = <200>;

        bindings = <&fn_num_4_hold>, <&kp>;
    };

    fn_num_5: fn_number_5 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "hold-preferred";
        tapping-term-ms = <200>;

        bindings = <&fn_num_5_hold>, <&kp>;
    };

    fn_num_6: fn_number_6 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "hold-preferred";
        tapping-term-ms = <200>;

        bindings = <&fn_num_6_hold>, <&kp>;
    };

    fn_num_7: fn_number_7 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "hold-preferred";
        tapping-term-ms = <200>;

        bindings = <&fn_num_7_hold>, <&kp>;
    };

    fn_num_8: fn_number_8 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "hold-preferred";
        tapping-term-ms = <200>;

        bindings = <&fn_num_8_hold>, <&kp>;
    };

    fn_num_9: fn_number_9 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "hold-preferred";
