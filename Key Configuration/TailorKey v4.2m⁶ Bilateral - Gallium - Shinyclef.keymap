        // Tap for Enter, hold to go to home layer.
        to_layer_tap: to_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&to>, <&kp>;
            flavor = "balanced";
            quick-tap-ms = <300>;
            require-prior-idle-ms = <0>;
        };

        // Sends a different keypress, depending on whether it's held or tapped.
        //
        // If you hold the key for longer than 200ms, the first keycode is sent. If you tap the key (release before 200ms), the second keycode is sent. If you press another key within the 200ms, the default/first behavior is activated.
        mod_tap_primary_preferred: mod_tap_primary_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
