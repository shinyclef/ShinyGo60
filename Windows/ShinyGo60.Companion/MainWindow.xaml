<Window x:Class="ShinyGo60.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShinyGo60 Companion"
        Width="820"
        Height="720"
        MinWidth="720"
        MinHeight="620"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="ShinyGo60 Companion" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="#657080"
                           Text="Keyboard status and mouse shortcut configuration" />
            </StackPanel>
            <Border x:Name="ConnectionBadge"
                    Grid.Column="1"
                    Padding="12,7"
                    VerticalAlignment="Center"
                    Background="#E1E6EC"
                    CornerRadius="14">
                <TextBlock x:Name="ConnectionBadgeValue"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#3F4855"
                           Text="STARTING" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,20,0,16"
                Padding="18,15"
                Background="White"
                BorderBrush="#DEE3E8"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#657080" FontSize="11" FontWeight="SemiBold" Text="ACTIVE LAYER" />
                    <TextBlock x:Name="LayerValue"
                               Margin="0,2,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="No keyboard" />
                    <TextBlock x:Name="TransportValue" Margin="0,2,0,0" Foreground="#657080" Text="Searching" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Foreground="#657080" FontSize="11" FontWeight="SemiBold" Text="LEFT" />
                    <TextBlock x:Name="LeftBatteryValue" Margin="0,2,0,0" FontSize="18" Text="—" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="24,0,4,0" VerticalAlignment="Center">
                    <TextBlock Foreground="#657080" FontSize="11" FontWeight="SemiBold" Text="RIGHT" />
                    <TextBlock x:Name="RightBatteryValue" Margin="0,2,0,0" FontSize="18" Text="—" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="18"
                Background="White"
                BorderBrush="#DEE3E8"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Shortcuts" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#657080"
                                   Text="Click a shortcut field, then press the mouse button or key combination." />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Margin="0,0,0,4" Foreground="#657080" Text="Preferred connection" />
                        <ComboBox x:Name="TransportPreferenceValue" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,15,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="#657080" FontSize="11" FontWeight="SemiBold" Text="SHORTCUT" />
                    <TextBlock Grid.Column="1" Foreground="#657080" FontSize="11" FontWeight="SemiBold" Text="ACTION" />
                    <TextBlock Grid.Column="2" Foreground="#657080" FontSize="11" FontWeight="SemiBold" Text="TARGET LAYER" />
                </Grid>

                <ListBox x:Name="ShortcutList"
                         Grid.Row="2"
                         Padding="0"
                         BorderBrush="#DEE3E8"
                         BorderThickness="1"
                         ItemsSource="{Binding ShortcutRows}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="5" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="OnShortcutPreviewKeyDown"
                                         ToolTip="Click here, then press the shortcut" />
                                <ComboBox Grid.Column="1"
                                          Margin="6,0"
                                          DisplayMemberPath="Label"
                                          ItemsSource="{Binding DataContext.AvailableActions, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          SelectedValue="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Value" />
                                <ComboBox Grid.Column="2"
                                          Margin="0,0,6,0"
                                          ItemsSource="{Binding DataContext.AvailableLayers, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          SelectedItem="{Binding TargetLayer, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="3"
                                        Padding="4"
                                        Click="OnRemoveShortcutClick"
                                        Content="×"
                                        Tag="{Binding}"
                                        ToolTip="Remove mapping" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button HorizontalAlignment="Left" Click="OnAddShortcutClick" Content="Add mapping" />
                    <CheckBox x:Name="StartWithWindowsValue"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Content="Start with Windows" />
                </Grid>

                <Expander Grid.Row="4" Margin="0,12,0,0" Header="Connection details">
                    <StackPanel Margin="4,8,4,0">
                        <TextBlock x:Name="OwnershipValue" Foreground="#4E5865" Text="Layer ownership: unknown" />
                        <TextBlock x:Name="ShortcutActivityValue"
                                   Margin="0,4,0,0"
                                   Foreground="#4E5865"
                                   Text="Waiting for shortcut input" />
                        <TextBlock x:Name="DetailValue"
                                   Margin="0,4,0,0"
                                   Foreground="#4E5865"
                                   Text="Starting Go60 discovery"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="LogPathValue"
                                   Margin="0,6,0,0"
                                   Foreground="#7A8490"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatusValue"
                       VerticalAlignment="Center"
                       Foreground="#4E5865"
                       Text="Changes are applied without restarting the app." />
            <Button Grid.Column="1" Margin="8,0,0,0" Click="OnReconnectClick" Content="Reconnect" />
            <Button Grid.Column="2" Margin="8,0,0,0" Click="OnHideClick" Content="Hide settings" />
            <Button Grid.Column="3" Margin="8,0,0,0" Click="OnExitClick" Content="Exit" />
            <Button x:Name="SaveButton"
                    Grid.Column="4"
                    Margin="8,0,0,0"
                    Background="#176B4D"
                    Foreground="White"
                    Click="OnSaveClick"
                    Content="Save and apply" />
        </Grid>
    </Grid>
</Window>
