<Window x:Class="ShinyGo60.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShinyGo60 Companion"
        Icon="Assets/Companion.ico"
        Width="920"
        Height="780"
        MinWidth="800"
        MinHeight="620"
        Background="{StaticResource CompanionBackground}"
        Foreground="{StaticResource CompanionText}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="ShinyGo60" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{StaticResource CompanionMutedText}"
                           Text="Your keyboard, at a glance." />
            </StackPanel>
            <Border x:Name="ConnectionBadge"
                    Grid.Column="1"
                    Padding="12,7"
                    VerticalAlignment="Center"
                    Background="#29323C"
                    CornerRadius="14">
                <TextBlock x:Name="ConnectionBadgeValue"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#BBC6D2"
                           Text="STARTING" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,20,0,16"
                Padding="24,22"
                Background="{StaticResource CompanionSurface}"
                BorderBrush="{StaticResource CompanionBorder}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="{StaticResource CompanionMutedText}" FontSize="11" FontWeight="SemiBold" Text="ACTIVE LAYER" />
                    <TextBlock x:Name="LayerValue"
                               Margin="0,2,0,0"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Text="No keyboard" />
                    <TextBlock x:Name="TransportValue" Margin="0,2,0,0" Foreground="{StaticResource CompanionMutedText}" Text="Searching" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource CompanionMutedText}" FontSize="11" FontWeight="SemiBold" Text="LEFT BATTERY" />
                    <TextBlock x:Name="LeftBatteryValue" Margin="0,2,0,0" FontSize="18" Text="—" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="24,0,4,0" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource CompanionMutedText}" FontSize="11" FontWeight="SemiBold" Text="RIGHT BATTERY" />
                    <TextBlock x:Name="RightBatteryValue" Margin="0,2,0,0" FontSize="18" Text="—" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="24"
                Background="{StaticResource CompanionSurface}"
                BorderBrush="{StaticResource CompanionBorder}"
                BorderThickness="1"
                CornerRadius="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Shortcuts" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource CompanionMutedText}"
                                   TextWrapping="Wrap"
                                   Text="Click a shortcut field, then press the mouse button or key combination." />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Margin="0,0,0,4" Foreground="{StaticResource CompanionMutedText}" Text="Preferred connection" />
                        <ComboBox x:Name="TransportPreferenceValue" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,15,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{StaticResource CompanionMutedText}" FontSize="11" FontWeight="SemiBold" Text="SHORTCUT" />
                    <TextBlock Grid.Column="1" Foreground="{StaticResource CompanionMutedText}" FontSize="11" FontWeight="SemiBold" Text="ACTION" />
                    <TextBlock Grid.Column="2" Foreground="{StaticResource CompanionMutedText}" FontSize="11" FontWeight="SemiBold" Text="TARGET LAYER" />
                </Grid>

                <ListBox x:Name="ShortcutList"
                         MinHeight="58" MaxHeight="240"
                         Background="Transparent"
                         Grid.Row="2"
                         Padding="0"
                         BorderBrush="{StaticResource CompanionBorder}"
                         BorderThickness="1"
                         ItemsSource="{Binding ShortcutRows}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="165" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="OnShortcutPreviewKeyDown"
                                         ToolTip="Click here, then press the shortcut" />
                                <ComboBox Grid.Column="1"
                                          Margin="6,0"
                                          DisplayMemberPath="Label"
                                          ItemsSource="{Binding DataContext.AvailableActions, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          SelectedValue="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Value" />
                                <ComboBox Grid.Column="2"
                                          Margin="0,0,6,0"
                                          ItemsSource="{Binding DataContext.AvailableLayers, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          SelectedItem="{Binding TargetLayer, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="3"
                                        Padding="4"
                                        Click="OnRemoveShortcutClick"
                                        Content="×"
                                        Tag="{Binding}"
                                        ToolTip="Remove mapping" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button HorizontalAlignment="Left" Click="OnAddShortcutClick" Content="Add mapping" />
                    <StackPanel Grid.Column="1"
                                Margin="16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource CompanionMutedText}" Text="Taskbar widget" />
                        <ComboBox x:Name="WidgetTaskbarValue"
                                  Width="245"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding WidgetTaskbarOptions}"
                                  ToolTip="Windows must show a taskbar on each display selected here." />
                    </StackPanel>
                    <CheckBox x:Name="StartWithWindowsValue"
                              Grid.Column="2"
                              VerticalAlignment="Center"
                              Content="Start with Windows" />
                </Grid>

                <StackPanel Grid.Row="4">
                    <TextBlock x:Name="LatestConnectionIssueValue" Margin="0,16,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource CompanionMutedText}" Text="Checking latest connection issue…" />
                    <Expander Margin="0,12,0,0" Header="Advanced Settings">
                        <StackPanel Margin="4,8,4,0">
                            <Expander x:Name="IssueHistoryExpander" Header="Connection Issue History">
                                <StackPanel Margin="4,8,4,0">
                                    <TextBlock x:Name="IssueHistoryStatusValue" TextWrapping="Wrap" Text="History updates automatically." />
                                    <TextBox x:Name="IssueHistoryValue" Margin="0,12,0,8" MaxHeight="260"
                                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                             BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Top"
                                             Text="Checking locally saved connection history…" />
                                    <Button x:Name="CopyIssueHistoryButton" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            IsEnabled="False" Click="OnCopyIssueHistoryClick" Content="Copy All" />
                                    <TextBlock x:Name="CopyIssueHistoryStatusValue" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource CompanionMutedText}" />
                                </StackPanel>
                            </Expander>
                            <Expander Margin="0,12,0,0" Header="Adaptive Bluetooth Latency">
                                <StackPanel Margin="4,10,8,0">
                                    <CheckBox x:Name="AdaptiveBluetoothEnabledValue" Content="Enable adaptive latency switching" />
                                    <TextBlock Margin="0,8,0,10" Foreground="{StaticResource CompanionMutedText}" TextWrapping="Wrap"
                                               Text="Lower latency favors responsiveness; higher latency favors battery life. Values count skipped connection events, not milliseconds. With switching off, the idle latency is used." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="Active latency (0–99)" />
                                        <TextBox x:Name="ActiveLatencyValue" Grid.Column="1" Margin="0,0,0,6"
                                                 IsEnabled="{Binding IsChecked, ElementName=AdaptiveBluetoothEnabledValue}" />
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Idle / fixed latency (active–99)" />
                                        <TextBox x:Name="IdleLatencyValue" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Use idle latency after (15–3600 seconds)" />
                                        <TextBox x:Name="IdleAfterValue" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                                                 IsEnabled="{Binding IsChecked, ElementName=AdaptiveBluetoothEnabledValue}" />
                                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Minimum time between changes (5–300 seconds)" />
                                        <TextBox x:Name="MinimumSwitchValue" Grid.Row="3" Grid.Column="1" />
                                    </Grid>
                                    <CheckBox x:Name="IdleWhenLockedValue" Margin="0,10,0,0" Content="Use idle latency when Windows is locked"
                                              IsEnabled="{Binding IsChecked, ElementName=AdaptiveBluetoothEnabledValue}" />
                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource CompanionMutedText}" TextWrapping="Wrap"
                                               Text="Changes wait for the minimum interval. Windows may negotiate different values. These controls require firmware 0.10.0 or later with protocol 1.3." />
                                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnResetBluetoothDefaultsClick" Content="Restore latency defaults" />
                                </StackPanel>
                            </Expander>
                            <Expander Margin="0,12,0,0" Header="Connection Details">
                                <StackPanel Margin="4,8,4,0">
                                    <TextBlock x:Name="VersionValue" Foreground="{StaticResource CompanionMutedText}" />
                                    <TextBlock x:Name="OwnershipValue" Foreground="{StaticResource CompanionMutedText}" Text="Layer ownership: unknown" />
                                    <TextBlock x:Name="ShortcutActivityValue"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource CompanionMutedText}"
                                               Text="Waiting for shortcut input" />
                                    <TextBlock x:Name="DetailValue"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource CompanionMutedText}"
                                               Text="Starting Go60 discovery"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="LogPathValue"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource CompanionMutedText}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatusValue" Grid.ColumnSpan="5" Margin="0,0,0,14"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource CompanionMutedText}"
                       Text="Changes are applied without restarting the app." />
            <Button Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Click="OnReconnectClick" Content="Reconnect" />
            <Button Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Click="OnHideClick" Content="Hide settings" />
            <Button Grid.Row="1" Grid.Column="3" Margin="8,0,0,0" Click="OnExitClick" Content="Exit" />
            <Button x:Name="SaveButton" Grid.Row="1"
                    Grid.Column="4"
                    Margin="8,0,0,0"
                    Background="{StaticResource CompanionAccent}"
                    BorderBrush="{StaticResource CompanionAccent}"
                    FontWeight="SemiBold"
                    Foreground="#10271F"
                    Click="OnSaveClick"
                    Content="Save and apply" />
        </Grid>
    </Grid>
</Window>

