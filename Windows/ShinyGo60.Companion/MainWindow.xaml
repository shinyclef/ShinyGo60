<Window x:Class="ShinyGo60.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShinyGo60 Companion"
        Width="640"
        Height="360"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="ShinyGo60 Companion" />
            <TextBlock Margin="0,12,0,0"
                       FontSize="15"
                       Text="The companion foundation is ready. Keyboard connections, shortcuts, configuration, and the widget will be added in later steps."
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
