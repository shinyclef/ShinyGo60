<Window x:Class="ShinyGo60.Companion.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShinyGo60 keyboard status"
        Width="252"
        Height="38"
        Left="-10000"
        Top="-10000"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Border x:Name="WidgetBorder"
            Background="#F2181D24"
            BorderBrush="#5AFFFFFF"
            BorderThickness="1"
            CornerRadius="5"
            MouseLeftButtonUp="OnWidgetMouseLeftButtonUp"
            ToolTip="ShinyGo60 status — click to open settings">
        <Grid Margin="9,2,9,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="StateStripe" Width="3" Margin="0,3" HorizontalAlignment="Left" CornerRadius="2" />
            <StackPanel Grid.Column="1" Margin="5,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="LayerValue"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="No keyboard"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ConnectionValue"
                           Margin="0,-1,0,0"
                           Foreground="#BFD0D5DC"
                           FontSize="8"
                           FontWeight="SemiBold"
                           Text="SEARCHING" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        TextElement.FontSize="12"
                        TextElement.Foreground="#E8FFFFFF">
                <TextBlock x:Name="LeftBatteryValue" Text="—" />
                <TextBlock x:Name="LeftBatteryPercent" Foreground="#BFD0D5DC" />
                <TextBlock x:Name="LeftBatteryStaleMarker" />
                <TextBlock Foreground="#BFD0D5DC" Text=" · " />
                <TextBlock x:Name="RightBatteryValue" Text="—" />
                <TextBlock x:Name="RightBatteryPercent" Foreground="#BFD0D5DC" />
                <TextBlock x:Name="RightBatteryStaleMarker" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
