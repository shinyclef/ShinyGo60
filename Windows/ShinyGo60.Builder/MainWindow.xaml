<Window x:Class="ShinyGo60.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShinyGo60 Firmware Builder"
        Width="780"
        Height="760"
        MinWidth="700"
        MinHeight="590"
        AllowDrop="True"
        Background="#F4F6F8"
        Drop="OnWindowDrop"
        PreviewDragOver="OnWindowPreviewDragOver"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      Margin="0,0,-8,0"
                      Padding="0,0,8,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="ShinyGo60 Firmware Builder" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="#657080"
                           Text="Turn one exported Go60 keymap into firmware for both halves" />
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="12,7"
                    VerticalAlignment="Center"
                    Background="#E1E6EC"
                    CornerRadius="14">
                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#3F4855" Text="WINDOWS 11" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,20,0,12"
                Padding="18,15"
                Background="White"
                BorderBrush="#DEE3E8"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Foreground="#657080" FontSize="11" FontWeight="SemiBold" Text="KEYMAP INPUT" />
                <StackPanel Grid.Row="1" Margin="0,5,0,0">
                    <TextBlock x:Name="KeymapNameValue" FontSize="18" FontWeight="SemiBold" Text="No keymap selected" />
                    <TextBlock x:Name="KeymapPathValue"
                               Margin="0,3,0,0"
                               Foreground="#657080"
                               Text="Put exactly one .keymap file in Input, choose one, or drop one here."
                               TextWrapping="Wrap"
                               ToolTipService.ShowDuration="30000" />
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,12,0,0" Orientation="Horizontal">
                    <Button Click="OnChooseKeymapClick" Content="Choose keymap…" />
                    <Button Margin="8,0,0,0" Click="OnOpenInputClick" Content="Open Input folder" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="18,15"
                Background="White"
                BorderBrush="#DEE3E8"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#657080" FontSize="11" FontWeight="SemiBold" Text="BUILD ENVIRONMENT" />
                    <TextBlock x:Name="PrerequisiteTitleValue"
                               Margin="0,5,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="Checking Docker Desktop…" />
                    <TextBlock x:Name="PrerequisiteDetailValue"
                               Margin="0,3,0,0"
                               MaxWidth="515"
                               Foreground="#657080"
                               Text="Checking the pinned compiler image and available disk space."
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="CheckAgainButton" Click="OnCheckAgainClick" Content="Check again" />
                    <Button x:Name="SetupHelpButton"
                            Margin="0,7,0,0"
                            Click="OnOpenSetupHelpClick"
                            Content="Setup help"
                            Visibility="Collapsed" />
                    <Button x:Name="CleanupButton"
                            Margin="0,7,0,0"
                            Click="OnCleanupClick"
                            Content="Clean cache…" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Padding="18,15"
                Background="White"
                BorderBrush="#DEE3E8"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="#657080" FontSize="11" FontWeight="SemiBold" Text="BUILD STATUS" />
                    <Border x:Name="StatusBadge"
                            Grid.Column="1"
                            Padding="10,5"
                            Background="#E7EAEE"
                            CornerRadius="12">
                        <TextBlock x:Name="StatusBadgeValue"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#454D58"
                                   Text="WAITING" />
                    </Border>
                </Grid>
                <TextBlock x:Name="StatusTitleValue"
                           Grid.Row="1"
                           Margin="0,4,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Choose a keymap to begin" />
                <TextBlock x:Name="StatusDetailValue"
                           Grid.Row="2"
                           Margin="0,3,0,0"
                           Foreground="#657080"
                           Text="The same finished UF2 is installed manually on both keyboard halves."
                           TextWrapping="Wrap" />
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <ProgressBar x:Name="BuildProgressValue" Height="8" Maximum="100" Visibility="Collapsed" />
                    <Border x:Name="ResultPanel"
                            Margin="0,12,0,0"
                            Padding="12"
                            Background="#F4F7F9"
                            CornerRadius="5"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ResultUf2Value" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ResultIdentityValue" Margin="0,4,0,0" Foreground="#657080" />
                            <TextBlock x:Name="ResultDurationValue" Margin="0,2,0,0" Foreground="#657080" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="OpenFailureLogButton"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Click="OnOpenFailureLogClick"
                            Content="Open failure log"
                            Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="#657080"
                       Text="The builder creates firmware; it never flashes the keyboard." />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OpenOutputButton" Click="OnOpenOutputClick" Content="Open Output" />
                <Button x:Name="CancelButton"
                        Margin="8,0,0,0"
                        Click="OnCancelClick"
                        Content="Cancel"
                        IsEnabled="False" />
                <Button x:Name="BuildButton"
                        Margin="8,0,0,0"
                        MinWidth="125"
                        Click="OnBuildClick"
                        Content="Build firmware"
                        IsDefault="True"
                        IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
